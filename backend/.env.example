# Скопируйте в .env и заполните. Файл .env в git не коммитить.

APP_NAME="FamilyTasks API"
API_PREFIX=/v1
DEBUG=false

# Разработка (ничего ставить не нужно):
DATABASE_URL=sqlite+aiosqlite:///./familytasks.db
# Продакшен на VPS:
# DATABASE_URL=postgresql+asyncpg://familytasks:ПАРОЛЬ@localhost:5432/familytasks

# Обязательно сгенерировать: openssl rand -hex 32
# При смене ключа все выданные access-токены становятся недействительными.
SECRET_KEY=замените-на-случайную-строку

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# JSON-массив. Мобильному клиенту CORS не нужен — оставьте пустым, если веб-админки нет.
CORS_ORIGINS=["*"]

# Защита /auth/login от перебора. Считаются только НЕУДАЧНЫЕ попытки,
# успешный вход обнуляет счётчик аккаунта.
# По аккаунту — жёстко: это защита конкретного пароля.
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
LOGIN_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=900
# По IP — мягче: вся семья может сидеть за одним домашним роутером.
LOGIN_RATE_LIMIT_IP_ATTEMPTS=20
LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=300

# Регистрация: считаются ВСЕ попытки, включая успешные.
REGISTER_RATE_LIMIT_IP_ATTEMPTS=5
REGISTER_RATE_LIMIT_IP_WINDOW_SECONDS=3600
